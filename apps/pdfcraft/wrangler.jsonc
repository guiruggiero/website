{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "pdfcraft",
    "main": "src/index.js",
    "compatibility_date": "2026-11-12",
    "observability": {"enabled": true},
    "workers_dev": false,
    "preview_urls": false,
    "routes": [
        {"pattern": "pdfcraft.guiruggiero.com", "custom_domain": true}
    ],
    "r2_buckets": [
        {"binding": "BUCKET", "bucket_name": "pdfcraft"}
    ]
}