{
  "name": "guipt",
  "description": "Firebase Cloud Function for GuiPT",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "private": true,
  "main": "index.js",
  "dependencies": {
    "@google/genai": "^2.11.0",
    "@langfuse/client": "^5.9.1",
    "@sentry/node": "^10.65.0",
    "axios": "^1.18.0",
    "firebase-functions": "^7.2.5",
    "nodemailer": "^9.0.3",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-google": "^0.14.0",
    "firebase-tools": "^15.23.0",
    "globals": "^17.6.0"
  },
  "overrides": {
    "uuid": ">=11.1.1"
  },
  "scripts": {
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "deploy": "npx firebase deploy --only functions:guipt",
    "deploy-guipt": "npx firebase deploy --only functions:guipt",
    "prompt-pull": "node --env-file=.env scripts/promptSync.js pull",
    "prompt-push": "node --env-file=.env scripts/promptSync.js push"
  }
}
